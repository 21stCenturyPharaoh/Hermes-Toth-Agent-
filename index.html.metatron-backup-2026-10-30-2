<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080808">
<meta name="description" content="Micdom AI Records — music, artists, broadcasting, H.A.L.L.EL. and the Metatron executive platform.">
<title>Micdom AI Records | Pharaoh Angels Inc.</title>
<link rel="manifest" href="./manifest.json">
<link rel="icon" href="./icon-192.png" type="image/png">
<style>
:root{color-scheme:dark;--black:#080808;--panel:#121212;--panel2:#171717;--gold:#e0bd58;--gold2:#f5df9a;--blue:#0b2442;--blue2:#123c68;--ink:#f7f3e8;--muted:#c1bba9;--line:rgba(224,189,88,.34);--max:1120px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--black);color:var(--ink);font:17px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--gold2);text-decoration:underline;text-underline-offset:4px}
a:hover,a:focus-visible{color:#fff}
button,a{touch-action:manipulation}
:focus-visible{outline:3px solid #fff;outline-offset:4px}
.skip{position:absolute;left:-9999px;top:8px;background:#fff;color:#000;padding:12px;z-index:1000}
.skip:focus{left:8px}
.wrap{width:min(calc(100% - 32px),var(--max));margin:auto}
header{position:sticky;top:0;z-index:50;background:rgba(5,5,5,.97);border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
.navrow{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{font-weight:900;letter-spacing:.08em;color:var(--gold2);text-decoration:none;font-size:15px}
nav{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
nav a{font-size:14px;font-weight:700;text-decoration:none}
.menu-button{display:none;background:#171717;color:var(--gold2);border:1px solid var(--line);border-radius:8px;padding:10px 14px;font-weight:800}
.hero{padding:58px 0 54px;background:radial-gradient(ellipse at 50% 0,rgba(224,189,88,.15),transparent 55%),linear-gradient(180deg,#101010,#080808)}
.hero-inner{display:grid;grid-template-columns:minmax(180px,330px) 1fr;gap:36px;align-items:center}
.logo-frame{padding:12px;border:1px solid var(--line);border-radius:18px;background:#050505;box-shadow:0 16px 50px #000}
.logo-frame img{display:block;width:100%;height:auto;max-height:330px;object-fit:contain;border-radius:10px}
.eyebrow{color:var(--gold);font-size:13px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}
h1{font-size:clamp(34px,6vw,66px);line-height:1.03;letter-spacing:-.035em;margin:12px 0;color:var(--gold2)}
h2{font-size:clamp(27px,4vw,42px);line-height:1.12;margin:0 0 14px;color:var(--gold2)}
h3{font-size:22px;line-height:1.2;margin:0 0 10px;color:var(--gold2)}
p{margin:0 0 14px;color:#e4dfd3}
.lead{font-size:clamp(18px,2.2vw,22px);max-width:690px}
.role{font-weight:900;color:#fff;font-size:18px;letter-spacing:.07em}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border-radius:10px;border:1px solid var(--gold);background:var(--gold);color:#090909;font-weight:900;text-decoration:none;text-align:center}
.btn.secondary{background:transparent;color:var(--gold2)}
.btn.blue{background:var(--blue2);border-color:#7bb9f3;color:#fff}
section{padding:54px 0;border-top:1px solid rgba(224,189,88,.16)}
.section-intro{max-width:760px;margin-bottom:26px}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.card{background:linear-gradient(145deg,#181818,#101010);border:1px solid var(--line);border-radius:14px;padding:22px;min-width:0}
.card p:last-child{margin-bottom:0}
.music{background:#0c0c0c}
.halel{background:linear-gradient(135deg,#111,#19140a)}
.broadcast{background:linear-gradient(135deg,#07182b,var(--blue),#08111e);border-block:1px solid #315d86}
.broadcast .card{background:rgba(2,11,22,.72);border-color:rgba(135,190,240,.4)}
.broadcast h2,.broadcast h3{color:#d5eaff}
.ops{background:#0d0d0d}
.cta-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.cta{display:flex;min-height:94px;align-items:center;justify-content:space-between;gap:12px;padding:18px;background:#151515;border:1px solid var(--line);border-radius:12px;color:var(--gold2);font-size:18px;font-weight:900;text-decoration:none}
.cta span{font-size:25px;color:var(--gold)}
.video-box{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.75fr);gap:20px;align-items:start}
video{width:100%;max-height:340px;background:#000;border:1px solid var(--line);border-radius:12px}
.expression-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
.expression{min-height:48px;padding:10px 8px;border:1px solid rgba(135,190,240,.55);border-radius:8px;background:#0b1b2b;color:#fff;font-weight:800}
.expression[aria-pressed="true"]{background:#e0bd58;color:#080808;border-color:#fff}
.note{font-size:14px;color:var(--muted)}
.admin{background:#0b0b0b;border:1px solid #705a28;border-radius:14px;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.admin .btn{background:#171717;color:var(--gold2)}
footer{padding:28px 0 42px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}
footer p{color:var(--muted)}
@media(max-width:760px){
 .hero-inner{grid-template-columns:1fr;gap:22px}.logo-frame{max-width:250px;margin:auto}
 .cards{grid-template-columns:1fr}.cta-grid{grid-template-columns:1fr 1fr}
 .video-box{grid-template-columns:1fr}
 nav{display:none;position:absolute;left:0;right:0;top:68px;padding:16px;background:#080808;border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch}
 nav.open{display:flex}nav a{padding:10px 4px}.menu-button{display:inline-flex}
 .admin{align-items:flex-start;flex-direction:column}
}
@media(max-width:420px){.cta-grid{grid-template-columns:1fr}.expression-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.wrap{width:min(calc(100% - 24px),var(--max))}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header>
 <div class="wrap navrow">
  <a class="brand" href="#top">MICDOM AI RECORDS</a>
  <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="mainNav">MENU</button>
  <nav id="mainNav" aria-label="Main navigation">
   <a href="#music">MUSIC & ARTISTS</a><a href="#halel">H.A.L.L.EL.</a><a href="#broadcast">BROADCAST</a><a href="#operations">OPERATIONS</a><a href="#access">METATRON</a>
  </nav>
 </div>
</header>
<main id="main">
<section class="hero" id="top">
 <div class="wrap hero-inner">
  <div class="logo-frame"><img src="data:image/webp;base64," alt="Pharaoh Angels Inc. — Micdom AI Records golden winged Pharaoh emblem"></div>
  <div>
   <div class="eyebrow">Pharaoh Angels Inc.</div>
   <h1>MICDOM<br>AI RECORDS</h1>
   <p class="role">METATRON — AI VICE PRESIDENT</p>
   <p class="lead">Music, artists, broadcasting and fan-powered experiences — brought together in one operating home.</p>
   <div class="actions"><a class="btn" href="#catalog">EXPLORE THE CATALOG</a><a class="btn secondary" href="#broadcast">ENTER THE BROADCAST</a></div>
  </div>
 </div>
</section>

<section class="music" id="music">
 <div class="wrap">
  <div class="section-intro"><div class="eyebrow">The label</div><h2>Music & Artists</h2><p>Discover the roster, releases, catalog and production work of Micdom AI Records. Artist and release details remain connected to the existing repository assets.</p></div>
  <div class="cards">
   <article class="card"><h3>Artist Roster</h3><p>Meet the voices, characters and creative collaborators behind the label.</p><a href="./roster.json">View the current roster data</a></article>
   <article class="card" id="catalog"><h3>The Catalog</h3><p>Explore recorded music and featured releases.</p><a href="https://ministry.pharaoh-conglomerate.org/?v=728e346">Open the existing music and ministry experience</a></article>
   <article class="card"><h3>Production & Releases</h3><p>Follow production, upcoming releases and artist campaigns from the label’s existing platform.</p><a href="#operations">View business operations</a></article>
  </div>
 </div>
</section>

<section class="halel" id="halel">
 <div class="wrap">
  <div class="section-intro"><div class="eyebrow">Community & participation</div><h2>H.A.L.L.EL.</h2><p><strong>AI Sorority · Fandom · Digital LARP · Volunteers</strong></p><p>A home for AI sorority personas, fan communities, audience participation, volunteer opportunities and real-world or digital LARP experiences. AI characters and human participants are clearly distinguished; real-world participation is voluntary.</p></div>
  <div class="cards">
   <article class="card"><h3>Enter H.A.L.L.EL.</h3><p>Meet the community and explore its current experiences.</p><a class="btn secondary" href="./v27/halel/">OPEN H.A.L.L.EL.</a></article>
   <article class="card"><h3>Digital LARP</h3><p>Join the story, learn the experience and take part in audience-led activities.</p><a href="./v27/halel/">Explore the LARP experience</a></article>
   <article class="card"><h3>Fan & Volunteer Community</h3><p>Support artist campaigns, share releases and participate by choice.</p><a href="https://registry.pharaoh-conglomerate.org/">Visit the Affiliate Accelerator</a></article>
  </div>
 </div>
</section>

<section class="broadcast" id="broadcast">
 <div class="wrap">
  <div class="section-intro"><div class="eyebrow">Live production</div><h2>Broadcasting</h2><p>DJ Dehrtay Dog LIVE and the Micdom broadcast experience. The expression clips below use the existing <code>dj/</code> media files in this Pages project.</p></div>
  <div class="video-box">
   <div>
    <video id="djVideo" controls playsinline preload="metadata" aria-label="DJ Dehrtay Dog expression preview">
     <source src="./dj/welcome.mp4" type="video/mp4">
     Your browser does not support HTML video.
    </video>
    <p class="note" id="expressionStatus" aria-live="polite">Selected expression: Welcome. Use the buttons to preview another expression.</p>
   </div>
   <div>
    <h3>DJ Dehrtay Dog — 8 Expressions</h3>
    <div class="expression-grid" id="expressionGrid">
     <button class="expression" type="button" data-expression="welcome" aria-pressed="true">Welcome</button>
     <button class="expression" type="button" data-expression="idle" aria-pressed="false">Idle</button>
     <button class="expression" type="button" data-expression="neutral" aria-pressed="false">Neutral</button>
     <button class="expression" type="button" data-expression="nodding" aria-pressed="false">Nodding</button>
     <button class="expression" type="button" data-expression="shocked" aria-pressed="false">Shocked</button>
     <button class="expression" type="button" data-expression="thinking" aria-pressed="false">Thinking</button>
     <button class="expression" type="button" data-expression="breaking" aria-pressed="false">Breaking</button>
     <button class="expression" type="button" data-expression="signoff" aria-pressed="false">Signoff</button>
    </div>
    <div class="actions"><a class="btn blue" href="./stage.html">OPEN DJ / METATRON STAGE</a></div>
    <p class="note">Broadcast destinations: TikTok LIVE · IMO · Rumble. Use the existing channel accounts and stage workflow; this homepage does not claim to start or control an external livestream.</p>
   </div>
  </div>
 </div>
</section>

<section class="ops" id="operations">
 <div class="wrap">
  <div class="section-intro"><div class="eyebrow">Label administration</div><h2>Business Operations</h2><p>Keep distribution, reporting, campaigns and financial oversight organized. Sensitive financial actions remain subject to the CEO’s approval and the controls of the relevant financial provider.</p></div>
  <div class="cards">
   <article class="card"><h3>Distribution</h3><p>Music distribution and release administration.</p><a href="https://routenote.com/" target="_blank" rel="noopener noreferrer">RouteNote</a></article>
   <article class="card"><h3>Reports & Campaigns</h3><p>Review performance, release planning and audience campaigns through the existing label workflows.</p><a href="https://ministry.pharaoh-conglomerate.org/?v=728e346">Open the existing ministry interface</a></article>
   <article class="card"><h3>Finance Controls</h3><p>Financial records and payments are not exposed on this public homepage. Metatron must not receive unrestricted banking credentials.</p><span class="note">CEO approval required for financial commitments.</span></article>
  </div>
 </div>
</section>

<section id="destinations">
 <div class="wrap">
  <div class="section-intro"><div class="eyebrow">Choose your next destination</div><h2>Enter the Micdom Universe</h2><p>Quick access to music, artists, broadcasting, community and commerce.</p></div>
  <div class="cta-grid">
   <a class="cta" href="#catalog">Listen to Catalog <span aria-hidden="true">›</span></a>
   <a class="cta" href="#music">Meet Artists <span aria-hidden="true">›</span></a>
   <a class="cta" href="./stage.html">DJ Dehrtay Dog LIVE <span aria-hidden="true">›</span></a>
   <a class="cta" href="./v27/halel/">Enter H.A.L.L.EL. <span aria-hidden="true">›</span></a>
   <a class="cta" href="./v27/halel/">Join Digital LARP <span aria-hidden="true">›</span></a>
   <a class="cta" href="https://registry.pharaoh-conglomerate.org/">Merch & Affiliate Accelerator <span aria-hidden="true">›</span></a>
  </div>
 </div>
</section>

<section id="access">
 <div class="wrap">
  <div class="admin">
   <div><div class="eyebrow">Executive access</div><h2>Metatron Command Center</h2><p>AI Vice President workspace. Executive controls are not displayed on this public homepage.</p><p class="note">The /admin sign-in route must be protected and verified separately before it is enabled.</p></div>
   <a class="btn" href="/admin">ADMIN ACCESS</a>
  </div>
 </div>
</section>
</main>
<footer>
 <div class="wrap">
  <p><strong>PHARAOH ANGELS INC. · MICDOM AI RECORDS</strong></p>
  <p>Metatron — AI Vice President · Music · Artists · Broadcasting · H.A.L.L.EL.</p>
  <p><a href="https://registry.pharaoh-conglomerate.org/">Registry commerce & Affiliate Accelerator</a> · <a href="https://ministry.pharaoh-conglomerate.org/?v=728e346">Ministry experience</a></p>
 </div>
</footer>
<script>
(function(){
 const menu=document.getElementById('menuButton');
 const nav=document.getElementById('mainNav');
 menu.addEventListener('click',function(){
   const open=nav.classList.toggle('open');
   menu.setAttribute('aria-expanded',String(open));
 });
 nav.addEventListener('click',function(e){
   if(e.target.closest('a')){nav.classList.remove('open');menu.setAttribute('aria-expanded','false');}
 });
 const video=document.getElementById('djVideo');
 const status=document.getElementById('expressionStatus');
 document.querySelectorAll('[data-expression]').forEach(function(button){
   button.addEventListener('click',function(){
     const name=button.getAttribute('data-expression');
     video.pause();
     video.src='./dj/'+name+'.mp4';
     video.load();
     status.textContent='Selected expression: '+name+'. Press Play to preview.';
     document.querySelectorAll('[data-expression]').forEach(function(b){
       b.setAttribute('aria-pressed',String(b===button));
     });
   });
 });
})();
</script>
</body>
</html>
